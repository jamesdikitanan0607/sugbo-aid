<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Background overlay for subtle animation -->
    <View
        android:id="@+id/view_background_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/glass_white_10"
        android:alpha="0.1" />

    <!-- Main content container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Logo and taglines container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">

            <!-- SugboAid Logo -->
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/sugboaid_logo"
                android:contentDescription="@string/cd_logo"
                android:layout_marginBottom="24dp"
                android:background="@drawable/logo_background"
                android:elevation="8dp" />

            <!-- Main tagline with SugboAid branding -->
            <TextView
                android:id="@+id/tv_tagline_main"
                style="@style/SugboAid.Text.Brand.Tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_tagline_main"
                android:gravity="center"
                android:layout_marginBottom="@dimen/brand_spacing_sm" />

            <!-- Sub tagline with SugboAid branding -->
            <TextView
                android:id="@+id/tv_tagline_sub"
                style="@style/SugboAid.Text.Brand.SubTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_tagline_sub"
                android:gravity="center" />

        </LinearLayout>

        <!-- Login/Signup Buttons Container -->
        <LinearLayout
            android:id="@+id/ll_auth_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="@string/login"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_signup"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="@string/signup"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>

