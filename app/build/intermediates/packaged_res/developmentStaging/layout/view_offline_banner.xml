<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Banner Icon -->
    <ImageView
        android:id="@+id/banner_icon"
        android:layout_width="@dimen/icon_size_small"
        android:layout_height="@dimen/icon_size_small"
        android:layout_marginEnd="@dimen/brand_spacing_sm"
        android:src="@drawable/ic_offline"
        android:contentDescription="@string/banner_icon"
        app:tint="@android:color/white" />

    <!-- Banner Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Main Message -->
        <TextView
            android:id="@+id/banner_message"
            style="@style/SugboAid.Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_mode_active"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <!-- Detail Message -->
        <TextView
            android:id="@+id/banner_detail"
            style="@style/SugboAid.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/brand_spacing_xs"
            android:textColor="@android:color/white"
            android:alpha="0.9"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/banner_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/brand_spacing_sm"
        android:layout_marginEnd="@dimen/brand_spacing_sm"
        android:progressTint="@android:color/white"
        android:progressBackgroundTint="@color/white_30"
        android:visibility="gone" />

    <!-- Sync Button -->
    <ImageView
        android:id="@+id/banner_sync_button"
        android:layout_width="@dimen/icon_size_small"
        android:layout_height="@dimen/icon_size_small"
        android:layout_marginStart="@dimen/brand_spacing_sm"
        android:src="@drawable/ic_sync"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/brand_spacing_xs"
        android:contentDescription="@string/sync_now"
        app:tint="@android:color/white"
        android:visibility="gone" />

</merge>