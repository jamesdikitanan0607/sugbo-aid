<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="background_color">@color/dark_background</color>
    <color name="background_primary">@color/dark_background</color>
    <color name="border_light">#404040</color>
    <color name="border_medium">#666666</color>
    <color name="bottom_nav_background">@color/dark_surface</color>
    <color name="button_disabled">#2D2D2D</color>
    <color name="button_outline">#404040</color>
    <color name="button_surface">@color/dark_surface_variant</color>
    <color name="button_text_disabled">#666666</color>
    <color name="card_background">@color/dark_surface</color>
    <color name="divider_color">#404040</color>
    <color name="fab_background_color">@color/primary_blue</color>
    <color name="fab_icon_color">@color/white</color>
    <color name="glass_border">#4DFFFFFF</color>
    <color name="glass_dark_20">#33000000</color>
    <color name="glass_dark_40">#66000000</color>
    <color name="glass_dark_60">#99000000</color>
    <color name="glass_white_10">#1AFFFFFF</color>
    <color name="glass_white_20">#33FFFFFF</color>
    <color name="glass_white_40">#66FFFFFF</color>
    <color name="glass_white_60">#99FFFFFF</color>
    <color name="overlay_background">#80000000</color>
    <color name="shadow_light">#33000000</color>
    <color name="shadow_medium">#4D000000</color>
    <color name="surface_elevated">#2D2D2D</color>
    <color name="surface_primary">@color/dark_surface</color>
    <color name="surface_secondary">@color/dark_surface_variant</color>
    <color name="surface_variant">#3A3A3A</color>
    <color name="text_hint">#666666</color>
    <color name="text_on_primary">@color/white</color>
    <color name="text_on_surface">@color/white</color>
    <color name="text_primary">@color/white</color>
    <color name="text_secondary">#B3B3B3</color>
    <color name="text_tertiary">#808080</color>
    <style name="GlassmorphicButtonPrimary" parent="GradientButton">
        <item name="android:background">@drawable/glassmorphic_button_primary</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="GlassmorphicButtonSuccess" parent="GradientButton">
        <item name="android:background">@drawable/glassmorphic_button_success</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="GlassmorphicCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorGlassBackground</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">?attr/colorGlassBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="GlassmorphicCardBlur" parent="GlassmorphicCard">
        <item name="android:background">@drawable/glassmorphic_card_background</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardElevation">12dp</item>
    </style>
    <style name="GlassmorphicStatisticsCard">
        <item name="android:background">@drawable/glassmorphic_statistics_card</item>
        <item name="android:elevation">8dp</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="StatisticsTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="StatisticsValue" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/light_blue</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
    <style name="Theme.SugboAid" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        
        <item name="colorPrimary">@color/light_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <item name="colorSecondary">@color/success_green</item>
        <item name="colorSecondaryVariant">@color/primary_green</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <item name="android:statusBarColor" ns1:targetApi="l">?attr/colorPrimaryVariant</item>
        
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/white</item>
        
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        
        
        <item name="colorSurfacePrimary">@color/surface_primary</item>
        <item name="colorSurfaceSecondary">@color/surface_secondary</item>
        <item name="colorSurfaceElevated">@color/surface_elevated</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorTextPrimary">@color/text_primary</item>
        <item name="colorTextSecondary">@color/text_secondary</item>
        <item name="colorTextTertiary">@color/text_tertiary</item>
        <item name="colorTextHint">@color/text_hint</item>
        <item name="colorTextOnPrimary">@color/text_on_primary</item>
        <item name="colorTextOnSurface">@color/text_on_surface</item>
        <item name="colorButtonSurface">@color/button_surface</item>
        <item name="colorButtonOutline">@color/button_outline</item>
        <item name="colorButtonDisabled">@color/button_disabled</item>
        <item name="colorButtonTextDisabled">@color/button_text_disabled</item>
        <item name="colorDivider">@color/divider_color</item>
        <item name="colorOverlayBackground">@color/overlay_background</item>
        <item name="colorShadowLight">@color/shadow_light</item>
        <item name="colorShadowMedium">@color/shadow_medium</item>
        <item name="colorBorderLight">@color/border_light</item>
        <item name="colorBorderMedium">@color/border_medium</item>
        <item name="colorGlassBackground">@color/glass_dark_20</item>
        <item name="colorGlassBorder">@color/glass_border</item>
    </style>
    <style name="Theme.SugboAid.Authentication" parent="Theme.SugboAid">
        <item name="android:windowBackground">@drawable/gradient_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/white</item>
        
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        
        <item name="android:textColorHint">@color/medium_gray</item>
        <item name="colorControlNormal">@color/medium_gray</item>
        <item name="colorControlActivated">@color/light_blue</item>
        <item name="colorControlHighlight">@color/primary_blue_20</item>
    </style>
</resources>