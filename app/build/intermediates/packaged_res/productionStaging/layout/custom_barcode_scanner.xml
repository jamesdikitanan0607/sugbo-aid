<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/auto">

    <!-- Camera Preview -->
    <com.journeyapps.barcodescanner.CameraPreview
        android:id="@+id/zxing_camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Viewfinder View with scanning overlay -->
    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Status Text -->
    <TextView
        android:id="@+id/zxing_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:background="@color/glass_dark_60"
        android:padding="8dp"
        android:text="Place QR code inside the viewfinder"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />

</merge>