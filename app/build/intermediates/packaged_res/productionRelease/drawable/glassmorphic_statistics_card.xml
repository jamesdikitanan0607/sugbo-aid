<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorShadowLight" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Base glassmorphic background -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorGlassBackground" />
            <corners android:radius="16dp" />
            <stroke 
                android:width="1dp" 
                android:color="?attr/colorGlassBorder" />
        </shape>
    </item>
    
    <!-- Inner highlight -->
    <item android:top="1dp" android:left="1dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
            <stroke 
                android:width="0.5dp" 
                android:color="?attr/colorGlassBorder" />
        </shape>
    </item>
</layer-list>