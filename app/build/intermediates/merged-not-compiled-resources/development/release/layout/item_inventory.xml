<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:backgroundTint="@color/item_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Item Icon -->
            <TextView
                android:id="@+id/tv_item_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_icon"
                android:gravity="center"
                android:textSize="20sp"
                android:layout_marginEnd="12dp"
                tools:text="🍚" />

            <!-- Item Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_item_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    tools:text="Rice" />

                <TextView
                    android:id="@+id/tv_item_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    tools:text="sacks" />

            </LinearLayout>

            <!-- Status and Trend Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Trend Indicator -->
                <ImageView
                    android:id="@+id/iv_trend_indicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"
                    tools:src="@drawable/ic_trend_up"
                    tools:visibility="visible" />

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_status_badge"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    tools:text="HEALTHY" />

                <!-- Low Stock Alert -->
                <ImageView
                    android:id="@+id/iv_low_stock_alert"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_warning"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

        <!-- Stock Information Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_stock_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                tools:text="150/200 sacks" />

            <TextView
                android:id="@+id/tv_stock_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_percentage_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                tools:text="75%" />

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_stock"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginBottom="8dp"
            android:progressDrawable="@drawable/progress_stock_level"
            tools:progress="75" />

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_remove_stock"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_outline"
                android:text="−"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/error_red"
                android:minWidth="40dp"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/tv_current_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="8dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:minWidth="40dp"
                android:gravity="center"
                tools:text="150" />

            <Button
                android:id="@+id/btn_add_stock"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_button_outline"
                android:text="+"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/success_green"
                android:minWidth="40dp"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <!-- Last Updated Info -->
        <TextView
            android:id="@+id/tv_last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            tools:text="Updated 2 hours ago" />

    </LinearLayout>

</androidx.cardview.widget.CardView>