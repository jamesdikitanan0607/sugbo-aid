<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/brand_spacing_sm"
    app:cardCornerRadius="@dimen/brand_corner_radius"
    app:cardElevation="@dimen/brand_elevation_card"
    android:background="@color/glass_white_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/brand_spacing_md"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_name"
                style="@style/SugboAid.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_user_email"
                style="@style/SugboAid.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_user_role"
                style="@style/SugboAid.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/brand_spacing_xs" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btn_change_role"
                style="@style/SugboAid.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_user_role"
                android:textSize="12sp"
                android:minHeight="36dp" />

            <Switch
                android:id="@+id/switch_user_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/brand_spacing_sm"
                android:text="" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
