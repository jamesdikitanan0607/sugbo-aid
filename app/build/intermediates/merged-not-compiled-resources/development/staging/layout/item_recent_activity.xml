<?xml version="1.0" encoding="utf-8"?>
<com.sugboaid.donation.views.GlassmorphicCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:glassBackgroundAlpha="0.1"
    app:glassBorderWidth="1dp"
    app:glassBorderColor="@color/glass_border">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Donation Type Icon -->
        <ImageView
            android:id="@+id/iv_donation_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="@color/primary_blue_20"
            android:src="@drawable/ic_money"
            android:padding="8dp"
            android:contentDescription="@string/donation_type_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/primary_blue" />

        <!-- Donor Name -->
        <TextView
            android:id="@+id/tv_donor_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="@id/iv_donation_icon"
            app:layout_constraintStart_toEndOf="@id/iv_donation_icon"
            app:layout_constraintEnd_toStartOf="@id/tv_amount"
            tools:text="John Doe" />

        <!-- Donation Description -->
        <TextView
            android:id="@+id/tv_donation_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/tv_donor_name"
            app:layout_constraintStart_toEndOf="@id/iv_donation_icon"
            app:layout_constraintEnd_toStartOf="@id/tv_amount"
            tools:text="Cash donation for relief operations" />

        <!-- Donation Amount -->
        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/success_green"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="@id/tv_donor_name"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="₱1,500.00" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tv_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            app:layout_constraintTop_toBottomOf="@id/tv_amount"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="2 hours ago" />

        <!-- Verification Badge (optional) -->
        <ImageView
            android:id="@+id/iv_verified_badge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_verified"
            android:contentDescription="@string/verified_donation"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_donation_description"
            app:layout_constraintStart_toStartOf="@id/tv_donation_description"
            app:tint="@color/success_green"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_verified_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/verified"
            android:textSize="12sp"
            android:textColor="@color/success_green"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/iv_verified_badge"
            app:layout_constraintBottom_toBottomOf="@id/iv_verified_badge"
            app:layout_constraintStart_toEndOf="@id/iv_verified_badge"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.sugboaid.donation.views.GlassmorphicCardView>