<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SugboAid" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/light_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/primary_green</item>
        <item name="colorSecondaryVariant">@color/success_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/light_gray</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/dark_gray</item>
        <!-- Customize your theme here. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        
        <!-- Custom theme attributes -->
        <item name="colorSurfacePrimary">@color/surface_primary</item>
        <item name="colorSurfaceSecondary">@color/surface_secondary</item>
        <item name="colorSurfaceElevated">@color/surface_elevated</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorTextPrimary">@color/text_primary</item>
        <item name="colorTextSecondary">@color/text_secondary</item>
        <item name="colorTextTertiary">@color/text_tertiary</item>
        <item name="colorTextHint">@color/text_hint</item>
        <item name="colorTextOnPrimary">@color/text_on_primary</item>
        <item name="colorTextOnSurface">@color/text_on_surface</item>
        <item name="colorButtonSurface">@color/button_surface</item>
        <item name="colorButtonOutline">@color/button_outline</item>
        <item name="colorButtonDisabled">@color/button_disabled</item>
        <item name="colorButtonTextDisabled">@color/button_text_disabled</item>
        <item name="colorDivider">@color/divider_color</item>
        <item name="colorOverlayBackground">@color/overlay_background</item>
        <item name="colorShadowLight">@color/shadow_light</item>
        <item name="colorShadowMedium">@color/shadow_medium</item>
        <item name="colorBorderLight">@color/border_light</item>
        <item name="colorBorderMedium">@color/border_medium</item>
        <item name="colorGlassBackground">@color/glass_white_20</item>
        <item name="colorGlassBorder">@color/glass_border</item>
    </style>
    
    <!-- Splash screen theme -->
    <style name="Theme.SugboAid.Splash" parent="Theme.SugboAid">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
    
    <!-- No ActionBar theme -->
    <style name="Theme.SugboAid.NoActionBar" parent="Theme.SugboAid">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    
    <!-- Glassmorphic Card Style -->
    <style name="GlassmorphicCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorGlassBackground</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">?attr/colorGlassBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>
    
    <!-- Enhanced Glassmorphic Card with Blur Effect -->
    <style name="GlassmorphicCardBlur" parent="GlassmorphicCard">
        <item name="android:background">@drawable/glassmorphic_card_background</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardElevation">12dp</item>
    </style>
    
    <!-- Glassmorphic Button Styles -->
    <style name="GlassmorphicButtonPrimary" parent="GradientButton">
        <item name="android:background">@drawable/glassmorphic_button_primary</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    
    <style name="GlassmorphicButtonSuccess" parent="GradientButton">
        <item name="android:background">@drawable/glassmorphic_button_success</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    
    <!-- Glassmorphic Statistics Card Style -->
    <style name="GlassmorphicStatisticsCard">
        <item name="android:background">@drawable/glassmorphic_statistics_card</item>
        <item name="android:elevation">8dp</item>
        <item name="android:padding">16dp</item>
    </style>
    
    <!-- Gradient Button Style -->
    <style name="GradientButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    
    <!-- Statistics Card Text Styles -->
    <style name="StatisticsTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/dark_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="StatisticsValue" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/primary_blue</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
    
    <style name="StatisticsChange" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <!-- Role Button Style -->
    <style name="RoleButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:elevation">4dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    
    <!-- Tab Text Appearance -->
    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="textAllCaps">false</item>
    </style>
    
    <!-- SugboAid Typography System -->
    <style name="SugboAid.Text" parent="android:Widget.TextView">
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <style name="SugboAid.Text.Headline" parent="SugboAid.Text">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="SugboAid.Text.Title" parent="SugboAid.Text">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="SugboAid.Text.Subtitle" parent="SugboAid.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="SugboAid.Text.Body" parent="SugboAid.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <style name="SugboAid.Text.Caption" parent="SugboAid.Text">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorTextSecondary</item>
    </style>
    
    <style name="SugboAid.Text.Button" parent="SugboAid.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Brand-specific text styles -->
    <style name="SugboAid.Text.Brand.Tagline" parent="SugboAid.Text.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">@color/glass_dark_40</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>
    
    <style name="SugboAid.Text.Brand.SubTagline" parent="SugboAid.Text.Body">
        <item name="android:textColor">@color/glass_white_60</item>
        <item name="android:shadowColor">@color/glass_dark_40</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>
    
    <!-- Enhanced Button Styles with SugboAid Branding -->
    <style name="SugboAid.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    
    <style name="SugboAid.Button.Primary" parent="SugboAid.Button">
        <item name="backgroundTint">@color/primary_blue</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>
    
    <style name="SugboAid.Button.Success" parent="SugboAid.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>
    
    <style name="SugboAid.Button.Warning" parent="SugboAid.Button">
        <item name="backgroundTint">@color/accent_yellow</item>
        <item name="android:textColor">@color/dark_gray</item>
        <item name="rippleColor">@color/ripple_dark</item>
    </style>
    
    <style name="SugboAid.Button.Danger" parent="SugboAid.Button">
        <item name="backgroundTint">@color/error_red</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>
    
    <!-- Enhanced Card Styles -->
    <style name="SugboAid.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/glass_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurfacePrimary</item>
        <item name="strokeColor">?attr/colorBorderLight</item>
        <item name="strokeWidth">1dp</item>
    </style>
    
    <style name="SugboAid.Card.Glassmorphic" parent="SugboAid.Card">
        <item name="cardBackgroundColor">?attr/colorGlassBackground</item>
        <item name="strokeColor">?attr/colorGlassBorder</item>
        <item name="strokeWidth">@dimen/glass_stroke_width</item>
        <item name="cardElevation">@dimen/glass_elevation</item>
    </style>
    
    <!-- Authentication Theme -->
    <style name="Theme.SugboAid.Authentication" parent="Theme.SugboAid">
        <item name="android:windowBackground">@drawable/gradient_background</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/dark_gray</item>
        <!-- Ensure Material Design TextInputLayout compatibility -->
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        <!-- Authentication-specific styling -->
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="colorControlNormal">@color/medium_gray</item>
        <item name="colorControlActivated">@color/primary_blue</item>
        <item name="colorControlHighlight">@color/primary_blue_20</item>
    </style>
</resources>