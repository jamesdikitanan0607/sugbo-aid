<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:background="@drawable/nav_header_background"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingLeft="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_md"
    android:paddingRight="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md"
    android:theme="@style/ThemeOverlay.MaterialComponents.Dark">

    <ImageView
        android:id="@+id/profileImage"
        android:layout_width="@dimen/avatar_size_large"
        android:layout_height="@dimen/avatar_size_large"
        android:contentDescription="Profile Image"
        android:paddingTop="@dimen/spacing_sm"
        app:srcCompat="@drawable/ic_person_circle" />

    <TextView
        android:id="@+id/userName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_sm"
        android:text="User Name"
        android:textAppearance="@style/TextAppearance.SugboAid.Body1"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/userEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="user@example.com"
        android:textAppearance="@style/TextAppearance.SugboAid.Body2"
        android:textColor="@color/white"
        android:alpha="0.8" />

    <TextView
        android:id="@+id/userRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/role_badge_background"
        android:paddingLeft="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingRight="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_xs"
        android:text="DONOR"
        android:textAppearance="@style/TextAppearance.SugboAid.Caption"
        android:textColor="@color/cebu_blue"
        android:textStyle="bold" />

</LinearLayout>